<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.preppilot.dev</string>

  <key>ProgramArguments</key>
  <array>
    <string>__UV__</string>
    <string>run</string>
    <string>uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8779</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__HOME__/prep-pilot-dev/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ENVIRONMENT</key>
    <string>development</string>
    <key>RELEASE</key>
    <string>__RELEASE__</string>
    <key>COOKIE_NAME</key>
    <string>prep_session_dev</string>
    <key>SCHEDULER_ENABLED</key>
    <false/>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/preppilot-dev.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/preppilot-dev.log</string>
</dict>
</plist>
